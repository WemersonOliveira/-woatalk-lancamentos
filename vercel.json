
{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "destination": "/blacknovember",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blacknovember/superaulas",
      "destination": "https://woatalk-superaulas.vercel.app/BlackNovember/superaulas"
    },
    {
      "source": "/blacknovember/superaulas/:path*",
      "destination": "https://woatalk-superaulas.vercel.app/BlackNovember/superaulas/:path*"
    }
  ]
}
